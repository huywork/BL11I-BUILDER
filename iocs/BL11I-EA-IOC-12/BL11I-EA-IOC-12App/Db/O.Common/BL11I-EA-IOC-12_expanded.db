#% archiver 1 Monitor
#% alh
record(calc, "BL11I-EA-IOC-12:FD_FREE") {
  field(DESC, "Available FDs")
  field(CALC, "B>0?B-A:C")
  field(INPA, "BL11I-EA-IOC-12:FD_CNT  NPP MS")
  field(INPB, "BL11I-EA-IOC-12:FD_MAX  NPP MS")
  field(INPC, "1000")
  field(HOPR, "150")
  field(LOLO, "5")
  field(LOW, "20")
  field(LLSV, "MAJOR")
  field(LSV, "MINOR")
  info(autosaveFields_pass0, "HOPR LOPR LOW LOLO LSV LLSV")
}

